<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Logs estructurados JSON enviados a stdout. Filebeat los recolecta del contenedor y los envia a Logstash. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"ms-auth"}</customFields>
            <fieldNames>
                <message>msg</message>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
