@startuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam sequenceArrowColor #1a4a8a
skinparam sequenceLifeLineBorderColor #64748b
skinparam sequenceParticipantBackgroundColor #1e3a5f
skinparam sequenceParticipantBorderColor #3b82f6
skinparam sequenceParticipantFontColor #ffffff
skinparam sequenceActorBackgroundColor #dae8fc
skinparam sequenceActorBorderColor #6c8ebf
skinparam databaseBackgroundColor #6b46c1
skinparam databaseBorderColor #9673a6
skinparam databaseFontColor #ffffff
skinparam queueBackgroundColor #b46504
skinparam queueBorderColor #d6b656
skinparam queueFontColor #ffffff
skinparam noteBackgroundColor #fff2cc
skinparam noteBorderColor #d6b656

title Flujo asíncrono — Notificación de inasistencia vía Kafka

actor "Docente" as DOC
participant "Frontend\n(Next.js)" as FE
participant "BFF" as BFF
participant "API Gateway" as GW
participant "MS-Asistencia" as ASIST
database "asist_db" as DB
queue "Kafka\ninasistencia.detectada" as KAFKA
participant "MS-Mensajeria" as MSG
database "msg_db" as DBMSG
actor "Apoderado" as APO

DOC -> FE : Registrar asistencia\n(estado = AUSENTE)
FE -> BFF : POST /api/v1/bff/asistencias
BFF -> GW : POST /api/v1/asistencias\n(Bearer JWT)
GW -> ASIST : valida JWT RS256\nenruta solicitud
ASIST -> DB : INSERT asistencia (JPA)
DB --> ASIST : OK

alt estado == AUSENTE
  ASIST -> KAFKA : publica InasistenciaEvent\n{asistenciaId, alumnoId, cursoId, fecha}
  note right of ASIST : @CircuitBreaker(name="kafkaCB")
else estado != AUSENTE
  note right of ASIST : no se publica evento
end

ASIST --> GW : 201 Created
GW --> BFF : 201 Created
BFF --> FE : 201 Created
FE --> DOC : Asistencia registrada

KAFKA -> MSG : @KafkaListener consume evento\n(group: mensajeria-group)
MSG -> DBMSG : INSERT mensaje (JPA)
DBMSG --> MSG : OK
MSG -> APO : Notificación de inasistencia\n(asíncrono, desacoplado del flujo HTTP)

@enduml
