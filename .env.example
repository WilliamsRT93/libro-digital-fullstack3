# =============================================================================
# Plantilla de variables de entorno
# Copia este archivo a .env y ajusta los valores. .env esta ignorado por git.
# =============================================================================

# ----- PostgreSQL (una BD por microservicio) -----
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=auth_pass
POSTGRES_ACAD_USER=acad_user
POSTGRES_ACAD_PASSWORD=acad_pass
POSTGRES_ASIST_USER=asist_user
POSTGRES_ASIST_PASSWORD=asist_pass
POSTGRES_MSG_USER=msg_user
POSTGRES_MSG_PASSWORD=msg_pass

# ----- Kafka -----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ----- MinIO / S3 -----
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=reportes-academicos

# ----- JWT -----
JWT_ISSUER=libro-clases-auth
JWT_EXPIRATION_MINUTES=60

# ----- API Gateway -----
JWT_PUBLIC_KEY_URL=http://ms-auth:8082/api/v1/auth/.well-known/jwks.json

# ----- BFF -----
GATEWAY_URL=http://api-gateway:8081

# ----- Frontend (Next.js, leida por next.config.js en build/runtime) -----
BFF_URL=http://bff:8080

# ----- Observabilidad -----
GRAFANA_ADMIN_PASSWORD=admin
